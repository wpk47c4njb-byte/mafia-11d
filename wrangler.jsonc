{
  "name": "mafia-11d",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "HUB", "class_name": "Hub" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room", "Hub"] }
  ],
  "rules": [
    { "type": "Text", "globs": ["**/*.html"], "fallthrough": true }
  ],
  "observability": { "enabled": true }
}
